{
  "protocol_id": "bsrn-location-zero-shot-v1",
  "dataset_doi": "10.1594/PANGAEA.957398",
  "target": {
    "source_column": "SWD",
    "name": "ghi_wm2",
    "description": "15-minute mean global horizontal irradiance",
    "clip_lower": 0.0
  },
  "aggregation": {
    "resolution_minutes": 15,
    "minimum_native_coverage": 0.8,
    "maximum_inferred_native_cadence_minutes": 10
  },
  "quality_control": {
    "primary_reject_bitmask": 3,
    "primary_policy": "Reject physically impossible low/high flags (bits 0 and 1); retain rare and comparison flags.",
    "sensitivity_policy": "Require QC code 0."
  },
  "station_splits": {
    "train": 33,
    "validation": 7,
    "test": 11,
    "test_locked_during_development": true
  },
  "context_steps": {
    "primary": 96,
    "sweep": [24, 96, 288, 672]
  },
  "forecast_horizon_steps": [1, 2, 4, 12, 24],
  "evaluation_eligibility": {
    "context_steps": 96,
    "minimum_context_ghi_fraction": 0.8,
    "require_current_ghi": true,
    "require_target_ghi": true,
    "require_exact_15_minute_continuity": true
  },
  "historical_features": [
    "ghi_wm2",
    "dni_wm2",
    "dhi_wm2",
    "lwd_wm2",
    "air_temperature_c",
    "relative_humidity_pct",
    "pressure_hpa"
  ],
  "known_future_features": [
    "solar_zenith_deg",
    "cos_zenith",
    "toa_horizontal_wm2",
    "utc_hour_sin",
    "utc_hour_cos",
    "day_of_year_sin",
    "day_of_year_cos"
  ],
  "static_features": ["latitude", "longitude", "elevation_m"],
  "primary_metrics": ["MAE", "RMSE", "nMAE", "smart_persistence_skill"],
  "secondary_metrics": ["ramp_MAE", "peak_memory_MiB", "inference_latency_ms"],
  "daylight_definition": "toa_horizontal_wm2 > 0",
  "forbidden": [
    "random row-level train/test splits",
    "normalization fitted on validation or test stations",
    "hyperparameter selection using test-station results",
    "future measured meteorology as an input"
  ]
}
